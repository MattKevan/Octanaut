{
  "name": "octanaut",
  "private": true,
  "version": "1.0.0",
  "description": "Octanaut - browser tracker with Preact panels and Tailwind",
  "scripts": {
    "build:css": "tailwindcss -i web/css/tailwind.css -o web/css/app.css --minify",
    "watch:css": "tailwindcss -i web/css/tailwind.css -o web/css/app.css --watch",
    "build:panels": "esbuild web/src/panels.tsx --bundle --format=iife --global-name=OctanautPanels --outfile=web/js/panels.js --jsx=automatic --jsx-import-source=preact --target=es2020 --minify",
    "watch:panels": "esbuild web/src/panels.tsx --bundle --format=iife --global-name=OctanautPanels --outfile=web/js/panels.js --jsx=automatic --jsx-import-source=preact --target=es2020 --watch",
    "build": "npm run build:css && npm run build:panels",
    "serve": "live-server web --port=3000 --no-browser --wait=200",
    "dev": "concurrently -k -n CSS,PANELS,SERVE -c blue,green,magenta \"npm:watch:css\" \"npm:watch:panels\" \"npm:serve\"",
    "typecheck": "tsc --noEmit",
    "test": "npm run typecheck && node --test test/core.test.js test/store.test.js test/engine.test.js test/export.test.js && node test/run.js"
  },
  "devDependencies": {
    "@tailwindcss/cli": "^4.3.4",
    "concurrently": "^10.0.6",
    "esbuild": "^0.28.2",
    "live-server": "^1.2.2",
    "tailwindcss": "^4.3.4",
    "typescript": "^7.0.2"
  },
  "dependencies": {
    "preact": "^11.1.1"
  }
}
